#!/bin/sh
# Wrapper so CMake can use `zig ranlib` as a normal ranlib.
# Uses $ZIG if set, else `zig` on PATH, else the pip package (`pip install ziglang`).
if [ -n "$ZIG" ]; then exec "$ZIG" ranlib "$@"; fi
if command -v zig >/dev/null 2>&1; then exec zig ranlib "$@"; fi
exec python3 -m ziglang ranlib "$@"
